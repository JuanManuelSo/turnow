# Copiar a .env.local y completar allí. No guardar secretos en este archivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Edición de la página pública (textos, contacto, redes y diseño).
# Desactivada en el MVP. Poner en true y reiniciar el servidor o reconstruir para retomarla.
NEXT_PUBLIC_PAGE_EDITOR_ENABLED=false

# La contraseña de estas URLs es la de la base de datos del proyecto Supabase
# (Settings → Database). No es la contraseña de la cuenta de Supabase ni una API key.
# Usuario runtime de privilegios limitados; pooler transaccional.
DATABASE_URL=

# Usuario administrador para migraciones; conexión directa o session pooler.
DATABASE_MIGRATION_URL=

# Clave AES-256-GCM (64 hex) para recuperar el código privado en reintentos idempotentes.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
BOOKING_CODE_ENCRYPTION_KEY=
