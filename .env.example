# Copiar a .env.local y completar allí. No guardar secretos en este archivo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# La contraseña de estas URLs es la de la base de datos del proyecto Supabase
# (Settings → Database). No es la contraseña de la cuenta de Supabase ni una API key.
# Usuario runtime de privilegios limitados; pooler transaccional.
DATABASE_URL=

# Usuario administrador para migraciones; conexión directa o session pooler.
DATABASE_MIGRATION_URL=
